{
  "name": "atoms-party",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/server.ts",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "esbuild src/server/server.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist/server --packages=external",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-loader-spinner": "^8.0.2",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
